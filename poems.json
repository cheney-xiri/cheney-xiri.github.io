    "author": "孔稚珪",
    "dynasty": "南北朝",
    "url": "https://www.gushiwen.cn/shiwenv_84b55ca77e82.aspx"
  },
  {
    "line": "肃肃秋风起，悠悠行万里",
    "title": "饮马长城窟行",
    "author": "杨广",
    "dynasty": "隋",
    "url": "https://www.gushiwen.cn/shiwenv_3ed6b877606a.aspx"
  },
  {
    "line": "画栋朝飞南浦云，珠帘暮卷西山雨",
    "title": "滕王阁",
    "author": "王勃",
    "dynasty": "唐",
    "url": "https://www.gushiwen.cn/shiwenv_433b9ec674cf.aspx"
  },
  {
    "line": "落花人独立，微雨燕双飞",
    "title": "春残",
    "author": "翁宏",
    "dynasty": "五代",
    "url": "https://www.gushiwen.cn/shiwenv_ad6df2bf88a9.aspx"
  },
  {
    "line": "桃李春风一杯酒，江湖夜雨十年灯",
    "title": "寄黄几复",
    "author": "黄庭坚",
    "dynasty": "宋",
    "url": "https://www.gushiwen.cn/shiwenv_cbbb4bd0d351.aspx"
  },
  {
    "line": "寒波澹澹起，白鸟悠悠下",
    "title": "颍亭留别",
    "author": "元好问",
    "dynasty": "金",
    "url": "https://www.gushiwen.cn/shiwenv_3f750ca8cdf0.aspx"
  },
  {
    "line": "杨柳风柔，海棠月淡，独自倚阑时",
    "title": "小阑干·去年人在凤凰池",
    "author": "萨都剌",
    "dynasty": "元",
    "url": "https://www.gushiwen.cn/shiwenv_30b7b3416427.aspx"
  },
  {
    "line": "寂历秋江渔火稀，起看残月映林微",
    "title": "江宿",
    "author": "汤显祖",
    "dynasty": "明",
    "url": "https://www.gushiwen.cn/shiwenv_c14f7d0c37b5.aspx"
  },
  {
    "line": "风也萧萧，雨也萧萧，瘦尽灯花又一宵",
    "title": "采桑子·谁翻乐府凄凉曲",
    "author": "纳兰性德",
    "dynasty": "清",
    "url": "https://www.gushiwen.cn/shiwenv_56191649bea1.aspx"
  },
  {
    "line": "山有扶苏，隰有荷华",
    "title": "山有扶苏",
    "author": "诗经·国风·郑风",
    "dynasty": "先秦",
    "url": "https://www.gushiwen.cn/shiwenv_2289572acfe0.aspx"
  },
  {
    "line": "微雨从东来，好风与之俱",
    "title": "读山海经·其一",
    "author": "陶渊明",
    "dynasty": "魏晋",
    "url": "https://www.gushiwen.cn/shiwenv_e80463a9d45e.aspx"
  },
  {
    "line": "明月照积雪，朔风劲且哀",
    "title": "岁暮",
    "author": "谢灵运",
    "dynasty": "南北朝",
    "url": "https://www.gushiwen.cn/shiwenv_dd9d562de905.aspx"
  }
]
