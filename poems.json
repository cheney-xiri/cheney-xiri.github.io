    "dynasty": "唐",
    "url": "https://www.gushiwen.cn/shiwenv_837510c0a7c4.aspx"
  },
  {
    "line": "换我心，为你心，始知相忆深",
    "title": "诉衷情·永夜抛人何处去",
    "author": "顾夐",
    "dynasty": "五代",
    "url": "https://www.gushiwen.cn/shiwenv_cda0e25b4442.aspx"
  },
  {
    "line": "人生如逆旅，我亦是行人",
    "title": "临江仙·送钱穆父",
    "author": "苏轼",
    "dynasty": "宋",
    "url": "https://www.gushiwen.cn/shiwenv_330cfc1476ad.aspx"
  },
  {
    "line": "问世间，情是何物，直教生死相许",
    "title": "摸鱼儿·雁丘词",
    "author": "元好问",
    "dynasty": "金",
    "url": "https://www.gushiwen.cn/shiwenv_8a860f142c0a.aspx"
  },
  {
    "line": "须信百年俱是梦，天地阔，且徜徉",
    "title": "江城子·疏云过雨漏斜阳",
    "author": "邵亨贞",
    "dynasty": "元",
    "url": "https://www.gushiwen.cn/shiwenv_783db51f9564.aspx"
  },
  {
    "line": "难将心事和人说，说与青天明月知",
    "title": "美人对月",
    "author": "唐寅",
    "dynasty": "明",
    "url": "https://www.gushiwen.cn/shiwenv_6e12b8487ca0.aspx"
  },
  {
    "line": "若似月轮终皎洁，不辞冰雪为卿热",
    "title": "蝶恋花·辛苦最怜天上月",
    "author": "纳兰性德",
    "dynasty": "清",
    "url": "https://www.gushiwen.cn/shiwenv_26b87875bd77.aspx"
  },
  {
    "line": "桃之夭夭，灼灼其华",
    "title": "桃夭",
    "author": "诗经·国风·周南",
    "dynasty": "先秦",
    "url": "https://www.gushiwen.cn/shiwenv_6ba04da3fdc1.aspx"
  },
  {
    "line": "一日不见兮，思之如狂",
    "title": "凤求凰",
    "author": "司马相如(存疑)",
    "dynasty": "汉",
    "url": "https://www.gushiwen.cn/shiwenv_13f153478a2a.aspx"
  },
  {
    "line": "人生无根蒂，飘如陌上尘",
    "title": "杂诗十二首·其一",
    "author": "陶渊明",
    "dynasty": "魏晋",
    "url": "https://www.gushiwen.cn/shiwenv_404930bd804c.aspx"
  },
  {
    "line": "人生亦有命，安能行叹复坐愁",
    "title": "拟行路难·其四",
    "author": "鲍照",
    "dynasty": "南北朝",
    "url": "https://www.gushiwen.cn/shiwenv_5261df279f62.aspx"
  },
  {
    "line": "人归落雁后，思发在花前",
    "title": "人日思归",
    "author": "薛道衡",
    "dynasty": "隋",
    "url": "https://www.gushiwen.cn/shiwenv_29252ac44d0f.aspx"
  },
  {
    "line": "莫道桑榆晚，为霞尚满天",
    "title": "酬乐天咏老见示",
    "author": "刘禹锡",
    "dynasty": "唐",
    "url": "https://www.gushiwen.cn/shiwenv_e07317133df0.aspx"
  },
  {
    "line": "花满渚，酒满瓯，万顷波中得自由",
    "title": "渔父·一棹春风一叶舟",
    "author": "李煜",
    "dynasty": "五代",
    "url": "https://www.gushiwen.cn/shiwenv_5e3b80583489.aspx"
  },
  {
    "line": "愿我如星君如月，夜夜流光相皎洁",
    "title": "车遥遥篇",
    "author": "范成大",
    "dynasty": "宋",
    "url": "https://www.gushiwen.cn/shiwenv_c5ce0ac560ea.aspx"
  },
  {
    "line": "多情却被无情恼，今夜还如昨夜长",
    "title": "鹧鸪天·候馆灯昏雨送凉",
    "author": "元好问",
    "dynasty": "金",
    "url": "https://www.gushiwen.cn/shiwenv_9fcf27cd99a3.aspx"
  },
  {
    "line": "傲杀人间万户侯，不识字烟波钓叟",
    "title": "沉醉东风·渔夫",
    "author": "白朴",
    "dynasty": "元",
    "url": "https://www.gushiwen.cn/shiwenv_d1e07474d2e2.aspx"
  },
  {
    "line": "往事思量一晌空，飞絮无情，依旧烟笼",
    "title": "一剪梅·咏柳",
    "author": "夏完淳",
    "dynasty": "明",
    "url": "https://www.gushiwen.cn/shiwenv_92f7fa53b00d.aspx"
  },
  {
    "line": "一箫一剑平生意，负尽狂名十五年",
    "title": "漫感",
    "author": "龚自珍",
    "dynasty": "清",
    "url": "https://www.gushiwen.cn/shiwenv_82fa006e52ad.aspx"
  },
  {
    "line": "执子之手，与子偕老",
    "title": "击鼓",
    "author": "诗经·国风·邶风",
    "dynasty": "先秦",
    "url": "https://www.gushiwen.cn/shiwenv_73b3c6badf1b.aspx"
  },
  {
    "line": "非学无以广才，非志无以成学",
    "title": "诫子书",
    "author": "诸葛亮",
    "dynasty": "汉",
    "url": "https://www.gushiwen.cn/shiwenv_c0509bfa84a1.aspx"
  },
  {
    "line": "悟已往之不谏，知来者之可追",
    "title": "归去来兮辞",
    "author": "陶渊明",
    "dynasty": "魏晋",
    "url": "https://www.gushiwen.cn/shiwenv_987458864738.aspx"
  },
  {
    "line": "日下壁而沉彩，月上轩而飞光",
    "title": "别赋",
    "author": "江淹",
    "dynasty": "南北朝",
    "url": "https://www.gushiwen.cn/shiwenv_d9a80a0ddc8f.aspx"
  },
  {
    "line": "灯树千光照，花焰七枝开",
