    "author": "于谦",
    "dynasty": "明",
    "url": "https://www.gushiwen.cn/shiwenv_ac213da310d5.aspx"
  },
  {
    "line": "一往情深深几许？深山夕照深秋雨",
    "title": "蝶恋花·出塞",
    "author": "纳兰性德",
    "dynasty": "清",
    "url": "https://www.gushiwen.cn/shiwenv_5f118f979884.aspx"
  },
  {
    "line": "既见君子，云胡不喜",
    "title": "风雨",
    "author": "诗经·国风·郑风",
    "dynasty": "先秦",
    "url": "https://www.gushiwen.cn/shiwenv_ef5d59cd84c7.aspx"
  },
